# Copy this file to .env and fill in your own values.
PORT=8080
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
ADMIN_EMAIL=admin@ipsglobalservice.com
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-unique-random-string-at-least-32-characters-long
VITE_ADMIN_ENTRY_PATH=/replace-with-your-private-admin-entry-path

# Local development stores uploads under this repository's uploads directory.
# VITE_STUDENT_LAUNCH=true  (focus the storefront on student academic support)
# Student-support Checkout: configure using verified merchant credentials. Never commit secrets.
# STRIPE_SECRET_KEY=sk_test_replace_on_host
# STRIPE_WEBHOOK_SECRET=whsec_replace_on_host
# PUBLIC_APP_URL=https://your-verified-domain.example
STORAGE_PROVIDER=local
# Optional local override. Use an absolute path outside the repository if desired.
# UPLOADS_DIR=C:\path\to\persistent\uploads

# Private Cloudflare R2 configuration. Production sets STORAGE_PROVIDER=r2.
# Keep these server-only names exactly as written. Never prefix them with VITE_.
# R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# R2_BUCKET_NAME=ips-private-prod-unique-suffix
# R2_ACCESS_KEY_ID=replace-with-a-bucket-scoped-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-the-secret-access-key
# R2_PREFIX=production
# R2_REQUEST_TIMEOUT_MS=60000

# Messaging providers (configure in secure backend environment only).
# Never place bot tokens, WhatsApp API credentials or webhook secrets in VITE_* variables.
# TELEGRAM_BOT_USERNAME=your-real-verified-business-bot
# TELEGRAM_BOT_TOKEN=configure-in-secret-manager
# TELEGRAM_WEBHOOK_SECRET=configure-in-secret-manager
# WHATSAPP_PUBLIC_NUMBER=international-digits-no-plus
# WHATSAPP_PHONE_NUMBER_ID=configure-in-secret-manager
# WHATSAPP_ACCESS_TOKEN=configure-in-secret-manager
# WHATSAPP_APP_SECRET=configure-in-secret-manager
# WHATSAPP_VERIFY_TOKEN=configure-in-secret-manager
# WHATSAPP_GRAPH_VERSION=review-supported-version-before-activation
